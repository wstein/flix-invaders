#!/bin/sh
# Run one of the sketches by name.
#
#   bin/sketch static
#   bin/sketch animation
#   bin/sketch invaders
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
name=${1:-}

case "$name" in
  static)    entry=Sketches.Still.main ;;
  animation) entry=Sketches.Animation.main ;;
  invaders)  entry=main ;;
  *)
    echo "usage: bin/sketch {static|animation|invaders}" >&2
    exit 2
    ;;
esac

exec "$root/bin/flix" run --entrypoint "$entry"
