#!/bin/sh
# Measure the demo bot, and optionally search for better numbers.
#
#   bin/bench                    play every seed with the stored tuning and report
#   bin/bench --recalc           search for a better tuning and save it if it wins
#   bin/bench --recalc=5         ...over at most five rounds (attached form, as getopt wants)
#   bin/bench --config ./t.json  use a particular config file
#   bin/bench --defaults         ignore the config; use the tuning compiled in
#   bin/bench --help
#
# Always compare the *rates*, never the totals: a change that ends games sooner posts
# fewer deaths and fewer row drops while being strictly worse. Rates are per 10000 ticks.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
# `--` separates the compiler's own options from the program's.
exec "$root/flix" run --entrypoint Bench.main -- "$@"
