#!/bin/sh
# Measure the demo bot across a fixed set of seeds.
#
#   bin/bench
#
# Prints per-seed outcomes and the aggregate rates. Everything it reports is a pure
# function of the seeds, so two runs of the same build give identical numbers, and any
# difference between builds is the change under test.
#
# Always compare the *rates*, never the totals: a change that ends games sooner posts
# fewer deaths and fewer row drops while being strictly worse.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
exec "$root/bin/flix" run --entrypoint Bench.main
